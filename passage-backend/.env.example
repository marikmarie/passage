# PHP application configuration
APP_ENV=development
CORS_ORIGIN=*

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=passage_db
DB_CHARSET=utf8mb4

# Authentication
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
TOKEN_SECRET=your_short_lived_watch_token_secret_here

# Optional integrations
ORS_API_KEY=
ORS_BASE_URL=https://api.openrouteservice.org
COLLECTO_API_KEY=your_collecto_api_key
COLLECTO_USERNAME=your_collecto_username
COLLECTO_BASE_URL=https://collecto.cissytech.com/api
SMS_API_KEY=your_sms_api_key
SMS_SENDER=PASSAGE
FCM_API_KEY=your_firebase_cloud_messaging_key
MAILER_API_KEY=your_mailer_api_key
MAILER_FROM_EMAIL=noreply@passage.local
